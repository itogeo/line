# Environment — never commit tokens
.env
**/.env

# Backed-up nested .git dirs (created during monorepo init)
**/.git.bak/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Raster data
*.tif
*.tiff

# Snowline daily tile WebPs — these live in Cloudflare R2, not git
# (static baseline WebPs in snowline/site/data/ and data/historical/ are kept)
snowline/site/data_10m/**/*.webp

# Snowline pipeline scratch space
snowline/cache/

# Lidar terrain tiles live in R2 (snowline/pipeline/build_lidar_terrain.py);
# terrain/shade.json (the tile index) is kept in git.
snowline/site/terrain/shade/

# Node
node_modules/

# Data downloads
riverline/data/

# OS / tooling junk
.DS_Store
.wrangler/
**/cache/
riverline/raw/
