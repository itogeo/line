# Environment — never commit tokens
.env
**/.env

# Backed-up nested .git dirs (created during monorepo init)
**/.git.bak/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Raster data
*.tif
*.tiff

# Snowline daily tile WebPs — these live in Cloudflare R2, not git
# (static baseline WebPs in snowline/site/data/ and data/historical/ are kept)
snowline/site/data_10m/**/*.webp

# Snowline pipeline scratch space
snowline/cache/

# Node
node_modules/

# Data downloads
riverline/data/

# OS / tooling junk
.DS_Store
.wrangler/
**/cache/
riverline/raw/
